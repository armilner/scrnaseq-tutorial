// Nextflow settings for a Slurm cluster. Account, partition and cache folder come from
// cluster/settings.sh. Change the resources below if your partition has different limits.
apptainer {
    enabled     = true
    autoMounts  = true
    cacheDir    = System.getenv('CACHE_DIR')
    pullTimeout = '2h'
}
executor {
    name            = 'slurm'
    queueSize       = 20
    submitRateLimit = '10/1min'
}
process {
    executor       = 'slurm'
    queue          = System.getenv('PARTITION')
    clusterOptions = "--account=${System.getenv('ACCOUNT')}"
    resourceLimits = [cpus: 32, memory: 60.GB, time: 48.h]
    withLabel:process_single { cpus = 1;  memory = 2.GB;  time = 12.h }
    withLabel:process_low    { cpus = 2;  memory = 4.GB;  time = 12.h }
    withLabel:process_medium { cpus = 8;  memory = 15.GB; time = 24.h }
    withLabel:process_high   { cpus = 32; memory = 60.GB; time = 24.h }
    // Cell Ranger took 1 to 4 hours per sample with these resources.
    withName:CELLRANGER_COUNT { cpus = 32; memory = 60.GB; time = 24.h }
}
// Some cluster file systems report free space wrongly, and Cell Ranger then refuses to start
// ("only N free inodes"). This turns that check off. It does not change the results.
env {
    MRO_DISK_SPACE_CHECK = 'disable'
    APPTAINERENV_MRO_DISK_SPACE_CHECK = 'disable'
}
